<Application x:Class="AICompanion.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!--
        ShutdownMode 设为 OnExplicitShutdown：
        主窗口是可隐藏的桌宠，关闭它不应结束进程（托盘仍需存活）。
        真正的退出走托盘菜单，那里会显式调用 Shutdown()。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <Style x:Key="BubbleBorder" TargetType="Border">
                <!--
                  近乎不透明：气泡会叠在角色立绘上，半透明底 + 浅色立绘会让文字看不清。
                  参考桌宠的做法，文字一律放在实心卡片上，与底图无关。
                -->
                <Setter Property="Background" Value="#F5141720" />
                <Setter Property="BorderBrush" Value="#4DFFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="Margin" Value="0,0,0,5" />
            </Style>

            <Style x:Key="BubbleText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFF7F9FC" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <!-- 12 → 13：小窗下 12px 中文笔画容易糊在一起 -->
                <Setter Property="FontSize" Value="13" />
                <Setter Property="LineHeight" Value="19" />
            </Style>

            <Style x:Key="SmallButton" TargetType="Button">
                <Setter Property="Background" Value="#33FFFFFF" />
                <Setter Property="Foreground" Value="#FFF0F0F0" />
                <Setter Property="BorderBrush" Value="#55FFFFFF" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="Margin" Value="3,0,0,0" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
