<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="AICompanion.app" />

  <!--
    高 DPI 感知（手册虽未提，但这是"换机器就错位"的根因）。

    开发机是 2560x1440 @ 175% 缩放，逻辑分辨率只有 1463x823。
    如果进程只做 System DPI 感知，把窗口拖到另一块不同缩放率的显示器上时，
    Windows 会做位图拉伸 —— 角色会变模糊、实际尺寸和期望尺寸对不上，
    鼠标命中判定也会偏。

    PerMonitorV2 让 WPF 在跨屏时自己按新 DPI 重新布局（内容仍是 DIP 单位）。
  -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/PM</dpiAware>

      <!--
        长路径支持。

        没有这一条时，安装位置一旦超过 260 个字符（深层目录、用户名很长的机器、
        或者被塞进一串嵌套文件夹里），进程创建就失败 —— 双击没反应，
        日志里一个字都不会有。实测放在 300 字符的路径下直接起不来。

        注意这只是"允许"：还要求系统的 LongPathsEnabled=1（Win10 1607 起可开）。
        两条都满足时，.NET 的文件 API 才按长路径处理。
      -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
