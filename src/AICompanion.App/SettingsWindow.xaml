<Window x:Class="AICompanion.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="880" Height="690"
        MinWidth="780" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 淡蓝主题：全部色值与控件样式只在该文件定义一次 -->
                <ResourceDictionary Source="Themes/SettingsTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!--
      布局只有三行：顶部 8 个标签 / 中间当前页 / 底部恢复默认。
      左侧那个"搜索 + 9 个分组"的侧栏已删除：分组与顶部标签是两套重复导航，
      而搜索框按注释只过滤当前页 —— 每页不超过 10 行，一眼能看完，搜索没有价值。
    -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶部：8 个标签 ==================== -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="6,5"
                Margin="0,0,0,10">
            <ListBox x:Name="NavTabs"
                     SelectionChanged="OnNavTabChanged"
                     BorderThickness="0"
                     Background="Transparent"
                     HorizontalAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBoxItem Style="{StaticResource NavTabItem}" Content="外观" Tag="外观" />
                <ListBoxItem Style="{StaticResource NavTabItem}" Content="对话" Tag="对话" />
                <ListBoxItem Style="{StaticResource NavTabItem}" Content="语音" Tag="语音" />
                <ListBoxItem Style="{StaticResource NavTabItem}" Content="互动" Tag="互动" />
                <ListBoxItem Style="{StaticResource NavTabItem}" Content="行为" Tag="行为" />
                <ListBoxItem Style="{StaticResource NavTabItem}" Content="诊断" Tag="诊断" />
                <ListBoxItem Style="{StaticResource NavTabItem}" Content="拓展" Tag="拓展" />
                <ListBoxItem Style="{StaticResource NavTabItem}" Content="关于" Tag="关于" />
            </ListBox>
        </Border>

        <!-- ==================== 中间：当前页 ==================== -->
        <ScrollViewer x:Name="ContentScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">
            <Grid>

                <!-- ==================== 外观：看得见的样子 ==================== -->
                <StackPanel x:Name="PageAppearance">
                    <TextBlock Style="{StaticResource PageTitle}" Text="外观" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="窗口" />
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="桌宠窗口" />
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="隐藏不退出进程"
                                               ToolTip="只是隐藏窗口，进程与语音服务继续运行；也可从托盘菜单显示/隐藏" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="显示 / 隐藏"
                                        Click="OnTogglePetVisibility"
                                        ToolTip="与托盘菜单「显示/隐藏角色」是同一个动作" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="模型与渲染" />

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="模型 / 立绘" />
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="换模型需重启"
                                               ToolTip="Live2D 优先于静态立绘；立绘与开关即时生效，换模型需重启" />
                                </StackPanel>
                                <ComboBox x:Name="AppearanceAssetCombo"
                                          Grid.Column="1"
                                          MinWidth="320"
                                          SelectionChanged="OnAppearanceAssetChanged" />
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Live2D 渲染" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="关闭即切回立绘" />
                                </StackPanel>
                                <CheckBox x:Name="Live2dCheck"
                                          Grid.Column="1"
                                          Content="启用"
                                          Checked="OnLive2dChanged"
                                          Unchecked="OnLive2dChanged" />
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="缩放等级" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="整体大小 · 即时生效" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="ScaleSlider"
                                            Width="200"
                                            Minimum="0.5"
                                            Maximum="2.5"
                                            TickFrequency="0.05"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="OnScaleChanged" />
                                    <TextBlock x:Name="ScaleText" Style="{StaticResource ValueText}" Width="52" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="透明态不透明度" />
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="仅透明态生效"
                                               ToolTip="覆盖态恒为不透明；透明态按此比例变淡" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="OpacitySlider"
                                            Width="200"
                                            Minimum="0.1"
                                            Maximum="1.0"
                                            TickFrequency="0.05"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="OnTransparentOpacityChanged" />
                                    <TextBlock x:Name="OpacityText" Style="{StaticResource ValueText}" Width="52" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="气泡时长" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="BubbleSecondsSlider"
                                            Width="200"
                                            Minimum="1"
                                            Maximum="30"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="OnBubbleSecondsChanged" />
                                    <TextBlock x:Name="BubbleSecondsText" Style="{StaticResource ValueText}" Width="52" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="模型水平微调" />
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="0 = 自动居中"
                                               ToolTip="Live2D 自带画布偏移时用来微调" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="HorizontalOffsetSlider"
                                            Width="170"
                                            Minimum="-0.30"
                                            Maximum="0.30"
                                            TickFrequency="0.01"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="OnHorizontalOffsetChanged" />
                                    <TextBlock x:Name="HorizontalOffsetText" Style="{StaticResource ValueText}" Width="76" Margin="10,0,0,0" />
                                    <Button Content="复位居中"
                                            Style="{StaticResource GhostButton}"
                                            Padding="8,3"
                                            MinWidth="0"
                                            Click="OnResetHorizontalOffset" />
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="AppearanceHintText"
                                       Style="{StaticResource AccentText}"
                                       Margin="0,6,0,0"
                                       Text="" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== 对话：模型与后端 ==================== -->
                <StackPanel x:Name="PageDialog" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="对话" />
                    <TextBlock Style="{StaticResource RowHint}"
                               Margin="0,0,0,10"
                               Text="改动下次启动生效"
                               ToolTip="对话相关的开关与下拉都只在启动时读取，改完重启程序才生效" />

                    <Button x:Name="DialogueGateBanner"
                            Style="{StaticResource GateBanner}"
                            Visibility="Collapsed"
                            Click="OnGoToExtend"
                            Content="尚未启用对话模块 · 去「拓展」添加" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="对话与模型" />

                            <StackPanel x:Name="DialogueGateArea">
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="对话（本地大模型）" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="关闭后不加载模型"
                                                   ToolTip="不加载 GGUF、不启动 llama-server" />
                                    </StackPanel>
                                    <CheckBox x:Name="LlmEnabledCheck"
                                              Grid.Column="1"
                                              Content="启用"
                                              Checked="OnLlmEnabledChanged"
                                              Unchecked="OnLlmEnabledChanged" />
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="模型" />
                                    <ComboBox x:Name="LlmModelCombo"
                                              Grid.Column="1"
                                              MinWidth="340"
                                              SelectionChanged="OnLlmModelChanged" />
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="上下文长度" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="自动 = 按模型上限"
                                                   ToolTip="按 GGUF 元数据取 min(模型上限, 8192)" />
                                    </StackPanel>
                                    <ComboBox x:Name="LlmContextCombo"
                                              Grid.Column="1"
                                              MinWidth="200"
                                              SelectionChanged="OnLlmContextChanged" />
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="显存策略" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="系统预留显存"
                                                   ToolTip="自动 = 按显存档位估算" />
                                    </StackPanel>
                                    <ComboBox x:Name="GpuStrategyCombo"
                                              Grid.Column="1"
                                              MinWidth="220"
                                              SelectionChanged="OnGpuStrategyChanged" />
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="后端选择" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="modules 下已识别的对话模块"
                                                   ToolTip="与「拓展」页的对话模块是同一份启用状态" />
                                    </StackPanel>
                                    <ComboBox x:Name="LlmBackendCombo"
                                              Grid.Column="1"
                                              MinWidth="260"
                                              SelectionChanged="OnLlmBackendChanged" />
                                </Grid>
                            </StackPanel>

                            <TextBlock x:Name="DialogHintText"
                                       Style="{StaticResource AccentText}"
                                       Margin="0,8,0,0"
                                       Text="" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== 语音：说话与听话 ==================== -->
                <StackPanel x:Name="PageVoice" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="语音" />
                    <TextBlock Style="{StaticResource RowHint}"
                               Margin="0,0,0,10"
                               Text="启用开关下次启动生效，引擎与音色即时生效" />

                    <!-- 真门禁：某一类"既无模块、也无内置实现"时才出现（见 ApplyGates）。 -->
                    <Button x:Name="TtsGateBanner"
                            Style="{StaticResource GateBanner}"
                            Visibility="Collapsed"
                            Click="OnGoToExtend"
                            Content="语音合成不可用 · 去「拓展」添加模块" />
                    <Button x:Name="AsrGateBanner"
                            Style="{StaticResource GateBanner}"
                            Visibility="Collapsed"
                            Click="OnGoToExtend"
                            Content="语音识别不可用 · 去「拓展」添加模块" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="说话" />
                            <StackPanel x:Name="VoiceTtsArea">
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="语音输出（TTS）" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="关闭后只显示文字气泡"
                                                   ToolTip="关闭后不出声；下次启动生效" />
                                    </StackPanel>
                                    <CheckBox x:Name="TtsEnabledCheck"
                                              Grid.Column="1"
                                              Content="启用"
                                              Checked="OnTtsEnabledChanged"
                                              Unchecked="OnTtsEnabledChanged" />
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="合成引擎" />
                                        <TextBlock x:Name="TtsEngineHintText" Style="{StaticResource RowHint}" Text="" />
                                    </StackPanel>
                                    <ComboBox x:Name="TtsEngineCombo"
                                              Grid.Column="1"
                                              MinWidth="240"
                                              SelectionChanged="OnTtsEngineChanged" />
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="音色" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="角色缺省时使用" />
                                    </StackPanel>
                                    <TextBox x:Name="TtsVoiceBox"
                                             Grid.Column="1"
                                             Width="240"
                                             TextChanged="OnTtsVoiceChanged" />
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="语速" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="与角色语速相乘" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider x:Name="TtsSpeedSlider"
                                                Width="180"
                                                Minimum="0.5"
                                                Maximum="2.0"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="OnTtsSpeedChanged" />
                                        <TextBlock x:Name="TtsSpeedText" Style="{StaticResource ValueText}" Width="56" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10" />

                            <TextBlock Style="{StaticResource SectionTitle}" Text="听话" />
                            <StackPanel x:Name="VoiceAsrArea">
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="语音输入（ASR）" />
                                        <TextBlock Style="{StaticResource RowHint}"
                                                   Text="关闭后不打开麦克风"
                                                   ToolTip="不加载识别模型、不打开麦克风；下次启动生效" />
                                    </StackPanel>
                                    <CheckBox x:Name="AsrEnabledCheck"
                                              Grid.Column="1"
                                              Content="启用"
                                              Checked="OnAsrEnabledChanged"
                                              Unchecked="OnAsrEnabledChanged" />
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="麦克风 / 采集源" />
                                        <TextBlock x:Name="MicDeviceText" Style="{StaticResource RowHint}" Text="识别中…" />
                                    </StackPanel>
                                    <ComboBox x:Name="AsrCaptureCombo"
                                              Grid.Column="1"
                                              MinWidth="220"
                                              SelectionChanged="OnAsrCaptureChanged" />
                                </Grid>

                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="听写" />
                                        <TextBlock x:Name="ListenHintText"
                                                   Style="{StaticResource RowHint}"
                                                   Text="常开监听模式下手动开关" />
                                    </StackPanel>
                                    <Button x:Name="ListenButton"
                                            Grid.Column="1"
                                            Content="开始 / 停止监听"
                                            Style="{StaticResource GhostButton}"
                                            Click="OnToggleListening" />
                                </Grid>

                                <TextBlock x:Name="AsrHintText"
                                           Style="{StaticResource AccentText}"
                                           Margin="0,4,0,0"
                                           Text="" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== 互动：鼠标键盘怎么碰它 ==================== -->
                <StackPanel x:Name="PageInteraction" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="互动" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="鼠标与键盘" />

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="悬停自动切换" />
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="悬停即恢复交互"
                                               ToolTip="鼠标悬停到角色上时自动从透明态切回可交互态" />
                                </StackPanel>
                                <CheckBox x:Name="HoverSwitchCheck"
                                          Grid.Column="1"
                                          Content="启用"
                                          Checked="OnHoverSwitchChanged"
                                          Unchecked="OnHoverSwitchChanged" />
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="鼠标穿透（透明模式）" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="点击穿透到桌面" />
                                </StackPanel>
                                <CheckBox x:Name="ClickThroughCheck"
                                          Grid.Column="1"
                                          Content="穿透"
                                          Checked="OnClickThroughChanged"
                                          Unchecked="OnClickThroughChanged" />
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="按住说话" />
                                    <TextBlock x:Name="PushToTalkHintText"
                                               Style="{StaticResource RowHint}"
                                               Text="按住热键才录音 · 下次启动生效"
                                               ToolTip="按住热键才录音，松开后整段识别" />
                                </StackPanel>
                                <CheckBox x:Name="PushToTalkCheck"
                                          Grid.Column="1"
                                          Content="启用"
                                          Checked="OnPushToTalkChanged"
                                          Unchecked="OnPushToTalkChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== 行为：游戏 / 空闲 / 启动位置 ==================== -->
                <StackPanel x:Name="PageBehavior" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="行为" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="空闲维护" />

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="空闲维护间隔" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="空闲多久可触发维护" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="IdleMinutesSlider"
                                            Width="200"
                                            Minimum="1"
                                            Maximum="30"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="OnIdleMinutesChanged" />
                                    <TextBlock x:Name="IdleMinutesText" Style="{StaticResource ValueText}" Width="52" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="维护冷却" />
                                    <TextBlock Style="{StaticResource RowHint}" Text="两轮维护的间隔" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider x:Name="IdleCooldownSlider"
                                            Width="200"
                                            Minimum="1"
                                            Maximum="60"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="OnIdleCooldownChanged" />
                                    <TextBlock x:Name="IdleCooldownText" Style="{StaticResource ValueText}" Width="52" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="启动位置" />

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowLabel}" Text="启动位置（DIP）" />
                                    <TextBlock x:Name="CurrentPositionText"
                                               Style="{StaticResource RowHint}"
                                               Text="当前位置 —" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="StartXBox"
                                             Width="76"
                                             TextChanged="OnStartPositionChanged"
                                             ToolTip="X（DIP）" />
                                    <TextBox x:Name="StartYBox"
                                             Width="76"
                                             Margin="6,0,0,0"
                                             TextChanged="OnStartPositionChanged"
                                             ToolTip="Y（DIP）" />
                                    <Button Content="取当前位置"
                                            Click="OnReadCurrentPosition"
                                            Style="{StaticResource GhostButton}"
                                            Margin="10,0,6,0" />
                                    <Button Content="立即移动"
                                            Click="OnMovePetNow"
                                            Style="{StaticResource GhostButton}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== 诊断：只读状态与排障动作 ==================== -->
                <StackPanel x:Name="PageDiagnostic" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="诊断" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="运行状态" />

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Width="88" Text="运行模式" />
                                <TextBlock x:Name="ModeText" Grid.Column="1" Style="{StaticResource ValueText}" Text="—" />
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Width="88" Text="对话" />
                                <TextBlock x:Name="LlmText" Grid.Column="1" Style="{StaticResource ValueText}" Text="—" />
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Width="88" Text="语音" />
                                <TextBlock x:Name="VoiceText" Grid.Column="1" Style="{StaticResource ValueText}" Text="—" />
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Width="88" Text="知识库" />
                                <TextBlock x:Name="KnowledgeText" Grid.Column="1" Style="{StaticResource ValueText}" Text="—" />
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Width="88" Text="显存" />
                                <TextBlock x:Name="GpuText" Grid.Column="1" Style="{StaticResource ValueText}" Text="—" />
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Width="88" Text="显卡" />
                                <TextBlock x:Name="GpuAdapterText" Grid.Column="1" Style="{StaticResource ValueText}" Text="—" />
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Width="88" Text="游戏检测" />
                                <Button Grid.Column="1"
                                        Content="重连"
                                        Style="{StaticResource GhostButton}"
                                        Padding="8,3"
                                        MinWidth="0"
                                        Margin="0,0,10,0"
                                        Click="OnReconnectMonitor" />
                                <TextBlock x:Name="MonitorText" Grid.Column="2" Style="{StaticResource ValueText}" Text="—" />
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Width="88" Text="启动问题" />
                                <TextBlock x:Name="ProblemText" Grid.Column="1" Style="{StaticResource ValueText}" Text="—" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="重新检测" Click="OnRedetectAll" />
                                <Button Content="重启语音服务" Click="OnRestartVoice" Style="{StaticResource GhostButton}" />
                                <Button Content="重置 ASR" Click="OnResetAsr" Style="{StaticResource GhostButton}" />
                                <Button Content="打开日志目录" Click="OnOpenLogFolder" Style="{StaticResource GhostButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="服务健康与告警" />
                            <ListBox x:Name="HealthList" Style="{StaticResource PlainList}" Height="96" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="待审核知识" />
                            <TextBlock Style="{StaticResource RowHint}"
                                       Text="确认后才入库"
                                       ToolTip="模型空闲时整理出的候选记忆；程序绝不自动写入" />
                            <ListBox x:Name="CandidateList"
                                     Style="{StaticResource PlainList}"
                                     Height="110"
                                     Margin="0,8,0,0"
                                     DisplayMemberPath="DisplayText" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="刷新" Click="OnRefreshCandidates" Style="{StaticResource GhostButton}" />
                                <Button Content="确认入库" Click="OnConfirmCandidate" />
                                <Button Content="丢弃" Click="OnDiscardCandidate" Style="{StaticResource GhostButton}" />
                                <Button Content="导入角色包" Click="OnImportCharacterPack" Style="{StaticResource GhostButton}" />
                                <TextBlock x:Name="CandidateStatusText" Style="{StaticResource ValueText}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="日志" />
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Width="88" Text="占用" />
                                <TextBlock x:Name="LogSizeText" Grid.Column="1" Style="{StaticResource ValueText}" Text="—" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="刷新" Click="OnRefreshLogs" Style="{StaticResource GhostButton}" />
                                <Button Content="清理应用日志" Click="OnPurgeAppLogs" Style="{StaticResource GhostButton}" />
                                <Button Content="清理旧聊天日志" Click="OnCleanupChatLogs" Style="{StaticResource GhostButton}" />
                                <Button Content="打开日志目录" Click="OnOpenLogFolder" Style="{StaticResource GhostButton}" />
                            </StackPanel>
                            <ListBox x:Name="LogList"
                                     Style="{StaticResource PlainList}"
                                     Height="150"
                                     Margin="0,8,0,0"
                                     FontFamily="Consolas"
                                     FontSize="11" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== 拓展：模块增删 ==================== -->
                <StackPanel x:Name="PageExtend" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="拓展" />

                    <!-- 一行摘要 + 两个动作：模块数量本身已经由下面三张卡片逐条列出，不再单开一张卡。 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock x:Name="EnvHintText"
                                       Style="{StaticResource RowLabel}"
                                       Text="模块 —" />
                            <TextBlock x:Name="ModuleHintText"
                                       Style="{StaticResource AccentText}"
                                       Text="" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="重新识别" Click="OnRedetectEnvironment" Style="{StaticResource GhostButton}" />
                            <Button Content="打开 modules" Click="OnOpenModulesFolder" Style="{StaticResource GhostButton}">
                                <Button.ToolTip>
                                    <TextBlock Text="modules\&lt;名称&gt;\module.json · kind 为 llm / tts / asr · entry 是模块目录内的可执行文件名" TextWrapping="Wrap" />
                                </Button.ToolTip>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="对话模块" />
                            <StackPanel x:Name="LlmModuleList" />
                            <Button Content="＋ 添加对话模块" Style="{StaticResource LinkButton}" Click="OnAddLlmModule" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="语音合成模块" />
                            <StackPanel x:Name="TtsModuleList" />
                            <Button Content="＋ 添加语音模块" Style="{StaticResource LinkButton}" Click="OnAddTtsModule" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="识别模块" />
                            <StackPanel x:Name="AsrModuleList" />
                            <Button Content="＋ 添加识别模块" Style="{StaticResource LinkButton}" Click="OnAddAsrModule" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== 关于：版本与来源 ==================== -->
                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="关于" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="本程序" />

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Width="88" Text="版本号" />
                                <TextBlock x:Name="VersionText" Grid.Column="1" Style="{StaticResource ValueText}" Text="—" />
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Width="88" Text="仓库地址" />
                                <TextBlock x:Name="RepoText" Grid.Column="1" Style="{StaticResource AccentText}" Text="—" />
                            </Grid>

                            <TextBlock Style="{StaticResource RowHint}"
                                       Margin="0,10,0,0"
                                       Text="config.yaml 只读 · 界面改动写入 Assets\appearance.json，删除该文件即恢复出厂默认"
                                       ToolTip="程序绝不回写 config.yaml；appearance.json 是界面覆盖层" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- ==================== 底部：恢复默认 + 自动保存状态 ==================== -->
        <Grid Grid.Row="2" Margin="2,8,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource LinkButton}"
                    Content="恢复默认"
                    Click="OnRestoreDefaults" />

            <TextBlock Grid.Column="2"
                       x:Name="AutoSaveText"
                       Style="{StaticResource ValueText}"
                       Text="自动保存" />
        </Grid>
    </Grid>
</Window>
