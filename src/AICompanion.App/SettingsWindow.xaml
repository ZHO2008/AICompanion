<Window x:Class="AICompanion.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="1040" Height="740"
        MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 淡蓝主题：全部色值与控件样式只在该文件定义一次 -->
                <ResourceDictionary Source="Themes/SettingsTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Separator" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{StaticResource BorderBrush}" />
                <Setter Property="Margin" Value="0,6" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶部：8 个标签 ==================== -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="6,5"
                Margin="0,0,0,10">
            <ListBox x:Name="NavTabs"
                     SelectionChanged="OnNavTabChanged"
                     BorderThickness="0"
                     Background="Transparent"
                     HorizontalAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBoxItem Style="{StaticResource NavTabItem}" Content="外观" Tag="外观" />
                <ListBoxItem Style="{StaticResource NavTabItem}" Content="对话" Tag="对话" />
                <ListBoxItem Style="{StaticResource NavTabItem}" Content="语音" Tag="语音" />
                <ListBoxItem Style="{StaticResource NavTabItem}" Content="互动" Tag="互动" />
                <ListBoxItem Style="{StaticResource NavTabItem}" Content="行为" Tag="行为" />
                <ListBoxItem Style="{StaticResource NavTabItem}" Content="诊断" Tag="诊断" />
                <ListBoxItem Style="{StaticResource NavTabItem}" Content="拓展" Tag="拓展" />
                <ListBoxItem Style="{StaticResource NavTabItem}" Content="关于" Tag="关于" />
            </ListBox>
        </Border>

        <!-- ==================== 主体：左侧搜索 + 分组，右侧内容 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧 -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="SearchBox"
                             Grid.Row="0"
                             TextChanged="OnSearchChanged"
                             ToolTip="按标签过滤当前页（大小写、全角、空白都不敏感）" />

                    <TextBlock Grid.Row="1"
                               Style="{StaticResource RowHint}"
                               Margin="2,6,0,8"
                               Text="仅当前页" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ListBox x:Name="GroupList" SelectionChanged="OnGroupChanged">
                                <ListBoxItem Style="{StaticResource GroupItem}" Content="隐藏窗口" Tag="隐藏窗口" />
                                <ListBoxItem Style="{StaticResource GroupItem}" Content="模型与渲染" Tag="模型与渲染" />
                                <ListBoxItem Style="{StaticResource GroupItem}" Content="对话与模型" Tag="对话与模型" />
                                <ListBoxItem Style="{StaticResource GroupItem}" Content="语音与听写" Tag="语音与听写" />
                                <ListBoxItem Style="{StaticResource GroupItem}" Content="互动设置" Tag="互动设置" />
                                <ListBoxItem Style="{StaticResource GroupItem}" Content="桌宠移动" Tag="桌宠移动" />
                                <ListBoxItem Style="{StaticResource GroupItem}" Content="行为与游戏" Tag="行为与游戏" />
                                <ListBoxItem Style="{StaticResource GroupItem}" Content="数据与诊断" Tag="数据与诊断" />
                                <ListBoxItem Style="{StaticResource GroupItem}" Content="拓展模块" Tag="拓展模块" />
                            </ListBox>
                            <TextBlock x:Name="SearchEmptyText"
                                       Style="{StaticResource RowHint}"
                                       Margin="4,10,0,0"
                                       Visibility="Collapsed"
                                       Text="没有匹配项" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右侧内容 -->
            <ScrollViewer x:Name="ContentScroll"
                          Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0">
                <Grid>

                    <!-- ==================== 外观 ==================== -->
                    <StackPanel x:Name="PageAppearance">
                        <TextBlock Style="{StaticResource PageTitle}" Text="外观" />

                        <Border x:Name="SectionHiddenWindow" Style="{StaticResource Card}" Tag="card">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="隐藏窗口" />
                                <Grid Margin="0,6" Tag="row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="桌宠窗口" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="隐藏不退出进程" ToolTip="只是隐藏窗口，进程与语音服务继续运行" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="隐藏桌宠" Click="OnHidePet" Style="{StaticResource GhostButton}" />
                                        <Button Content="显示桌宠" Click="OnShowPet" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,6" Tag="row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="始终置顶" />
                                    <TextBlock x:Name="AlwaysOnTopText" Grid.Column="1" Style="{StaticResource ValueText}" Text="—" />
                                </Grid>
                                <Grid Margin="0,6" Tag="row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="托盘图标" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" Text="常驻" ToolTip="关闭窗口后仍可唤出" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SectionModelRender" Style="{StaticResource Card}" Tag="card">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="模型与渲染" />

                                <Grid Margin="0,6" Tag="row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="模型 / 立绘" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="换模型需重启" ToolTip="Live2D 优先于静态立绘；立绘与开关即时生效，换模型需重启" />
                                    </StackPanel>
                                    <ComboBox x:Name="AppearanceAssetCombo"
                                              Grid.Column="1"
                                              MinWidth="320"
                                              SelectionChanged="OnAppearanceAssetChanged" />
                                </Grid>

                                <Grid Margin="0,6" Tag="row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Live2D 渲染" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="关闭即切回立绘" />
                                    </StackPanel>
                                    <CheckBox x:Name="Live2dCheck"
                                              Grid.Column="1"
                                              Content="启用"
                                              Checked="OnLive2dChanged"
                                              Unchecked="OnLive2dChanged" />
                                </Grid>

                                <Grid Margin="0,6" Tag="row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="缩放等级" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="整体大小 · 即时生效" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider x:Name="ScaleSlider"
                                                Width="200"
                                                Minimum="0.5"
                                                Maximum="2.5"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="OnScaleChanged" />
                                        <TextBlock x:Name="ScaleText" Style="{StaticResource ValueText}" Width="52" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,6" Tag="row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="渲染分辨率" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="按屏幕 DPI 换算" ToolTip="由角色大小与屏幕 DPI 决定，没有独立的分辨率配置项" />
                                    </StackPanel>
                                    <TextBlock x:Name="RenderResolutionText" Grid.Column="1" Style="{StaticResource ValueText}" Text="—" />
                                </Grid>

                                <Grid Margin="0,6" Tag="row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="透明态不透明度" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="仅透明态生效" ToolTip="覆盖态恒为不透明；透明态按此比例变淡" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider x:Name="OpacitySlider"
                                                Width="200"
                                                Minimum="0.1"
                                                Maximum="1.0"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="OnTransparentOpacityChanged" />
                                        <TextBlock x:Name="OpacityText" Style="{StaticResource ValueText}" Width="52" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,6" Tag="row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="气泡时长" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider x:Name="BubbleSecondsSlider"
                                                Width="200"
                                                Minimum="1"
                                                Maximum="30"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="OnBubbleSecondsChanged" />
                                        <TextBlock x:Name="BubbleSecondsText" Style="{StaticResource ValueText}" Width="52" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,6" Tag="row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowLabel}" Text="模型水平微调" />
                                        <TextBlock Style="{StaticResource RowHint}" Text="0 = 自动居中" ToolTip="Live2D 自带画布偏移时用来微调" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider x:Name="HorizontalOffsetSlider"
                                                Width="170"
                                                Minimum="-0.30"
                                                Maximum="0.30"
                                                TickFrequency="0.01"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="OnHorizontalOffsetChanged" />
                                        <TextBlock x:Name="HorizontalOffsetText" Style="{StaticResource ValueText}" Width="76" Margin="10,0,0,0" />
                                        <Button Content="复位居中"
                                                Style="{StaticResource GhostButton}"
                                                Padding="8,3"
                                                MinWidth="0"
                                                Click="OnResetHorizontalOffset" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="AppearanceHintText"
                                           Style="{StaticResource AccentText}"
                                           Margin="0,6,0,0"
                                           Text="自动保存 · 不改 config.yaml" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== 对话 ==================== -->
                    <StackPanel x:Name="PageDialog" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="对话" />

                        <Button x:Name="DialogueGateBanner"
                                Style="{StaticResource GateBanner}"
                                Visibility="Collapsed"
                                Click="OnGoToExtend"
                                Content="尚未启用对话模块 · 去「拓展」添加" />

                        <Border x:Name="SectionDialog" Style="{StaticResource Card}" Tag="card">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="对话与模型" />

                                <StackPanel x:Name="DialogueGateArea">
                                    <Grid Margin="0,6" Tag="row">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="对话（本地大模型）" />
                                            <TextBlock Style="{StaticResource RowHint}" Text="关闭后不加载模型" ToolTip="不加载 GGUF、不启动 llama-server（下次启动生效）" />
                                        </StackPanel>
                                        <CheckBox x:Name="LlmEnabledCheck"
                                                  Grid.Column="1"
                                                  Content="启用"
                                                  Checked="OnLlmEnabledChanged"
                                                  Unchecked="OnLlmEnabledChanged" />
                                    </Grid>

                                    <Grid Margin="0,6" Tag="row">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="模型路径" />
                                            <TextBlock Style="{StaticResource RowHint}" Text="下次启动生效" ToolTip="models/llm/**/*.gguf" />
                                        </StackPanel>
                                        <ComboBox x:Name="LlmModelCombo"
                                                  Grid.Column="1"
                                                  MinWidth="340"
                                                  SelectionChanged="OnLlmModelChanged" />
                                    </Grid>

                                    <Grid Margin="0,6" Tag="row">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="上下文长度" />
                                            <TextBlock Style="{StaticResource RowHint}" Text="自动 = 按模型上限" ToolTip="按 GGUF 元数据取 min(模型上限, 8192)" />
                                        </StackPanel>
                                        <ComboBox x:Name="LlmContextCombo"
                                                  Grid.Column="1"
                                                  MinWidth="200"
                                                  SelectionChanged="OnLlmContextChanged" />
                                    </Grid>

                                    <Grid Margin="0,6" Tag="row">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="显存策略" />
                                            <TextBlock Style="{StaticResource RowHint}" Text="下次启动生效" ToolTip="系统预留显存；自动 = 按显存档位估算" />
                                        </StackPanel>
                                        <ComboBox x:Name="GpuStrategyCombo"
                                                  Grid.Column="1"
                                                  MinWidth="220"
                                                  SelectionChanged="OnGpuStrategyChanged" />
                                    </Grid>

                                    <Grid Margin="0,6" Tag="row">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="后端选择" />
                                            <TextBlock Style="{StaticResource RowHint}" Text="下次启动生效" ToolTip="对应 modules/ 下已识别的对话模块" />
                                        </StackPanel>
                                        <ComboBox x:Name="LlmBackendCombo"
                                                  Grid.Column="1"
                                                  MinWidth="260"
                                                  SelectionChanged="OnLlmBackendChanged" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock x:Name="AiToggleHintText"
                                           Style="{StaticResource AccentText}"
                                           Margin="0,8,0,0"
                                           Text="跟随 config.yaml" />
                                <TextBlock x:Name="DialogHintText"
                                           Style="{StaticResource RowHint}"
                                           Margin="0,4,0,0"
                                           Text="开关类改动下次启动生效" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== 语音 ==================== -->
                    <StackPanel x:Name="PageVoice" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="语音" />

                        <!--
                            中性提示：默认包里没有 tts/asr 模块，但内置实现（SAPI / ai_asr.dll）
                            本来就能用。这里只提示"现在走的是内置路径"，可点进「拓展」，
                            **不禁用**下面的任何通用配置项。
                        -->
                        <Button x:Name="VoiceBuiltinHint"
                                Style="{StaticResource GateBanner}"
                                Visibility="Collapsed"
                                Click="OnGoToExtend"
                                Content="内置引擎 · 可在「拓展」添加模块" />

                        <!-- 真门禁：某一类"既无模块、也无内置实现"时才出现（见 ApplyGates）。 -->
                        <Button x:Name="TtsGateBanner"
                                Style="{StaticResource GateBanner}"
                                Visibility="Collapsed"
                                Click="OnGoToExtend"
                                Content="语音合成不可用 · 去「拓展」添加模块" />
                        <Button x:Name="AsrGateBanner"
                                Style="{StaticResource GateBanner}"
                                Visibility="Collapsed"
                                Click="OnGoToExtend"
                                Content="语音识别不可用 · 去「拓展」添加模块" />

                        <Border x:Name="SectionVoice" Style="{StaticResource Card}" Tag="card">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="语音与听写" />
                                <StackPanel x:Name="VoiceTtsArea">
                                    <Grid Margin="0,6" Tag="row">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="语音输出（TTS）" />
                                            <TextBlock Style="{StaticResource RowHint}" Text="下次启动生效" ToolTip="关闭后只显示文字气泡、不出声" />
                                        </StackPanel>
                                        <CheckBox x:Name="TtsEnabledCheck"
                                                  Grid.Column="1"
                                                  Content="启用"
                                                  Checked="OnTtsEnabledChanged"
                                                  Unchecked="OnTtsEnabledChanged" />
                                    </Grid>

                                    <Grid Margin="0,6" Tag="row">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="合成引擎" />
                                            <TextBlock x:Name="TtsEngineHintText" Style="{StaticResource RowHint}" Text="" />
                                        </StackPanel>
                                        <ComboBox x:Name="TtsEngineCombo"
                                                  Grid.Column="1"
                                                  MinWidth="220"
                                                  SelectionChanged="OnTtsEngineChanged" />
                                    </Grid>

                                    <Grid Margin="0,6" Tag="row">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="音色" />
                                            <TextBlock Style="{StaticResource RowHint}" Text="角色缺省时使用" />
                                        </StackPanel>
                                        <TextBox x:Name="TtsVoiceBox"
                                                 Grid.Column="1"
                                                 Width="240"
                                                 TextChanged="OnTtsVoiceChanged" />
                                    </Grid>

                                    <Grid Margin="0,6" Tag="row">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="语速" />
                                            <TextBlock Style="{StaticResource RowHint}" Text="与角色语速相乘" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider x:Name="TtsSpeedSlider"
                                                    Width="180"
                                                    Minimum="0.5"
                                                    Maximum="2.0"
                                                    TickFrequency="0.05"
                                                    IsSnapToTickEnabled="True"
                                                    ValueChanged="OnTtsSpeedChanged" />
                                            <TextBlock x:Name="TtsSpeedText" Style="{StaticResource ValueText}" Width="56" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,6" Tag="row">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="当前引擎" />
                                        <TextBlock x:Name="TtsEngineText" Grid.Column="1" Style="{StaticResource ValueText}" Text="—" />
                                    </Grid>
                                    <Grid Margin="0,6" Tag="row">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="全局默认音色" />
                                        <TextBlock x:Name="TtsVoiceText" Grid.Column="1" Style="{StaticResource ValueText}" MaxWidth="460" Text="—" />
                                    </Grid>
                                    <Grid Margin="0,6" Tag="row">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="运行中的引擎" />
                                        <TextBlock x:Name="TtsPiperText" Grid.Column="1" Style="{StaticResource ValueText}" MaxWidth="460" Text="—" />
                                    </Grid>
                                    <Grid Margin="0,6" Tag="row">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="语音服务" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="重启语音服务" Click="OnRestartVoice" Style="{StaticResource GhostButton}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <Border Style="{StaticResource Separator}" />

                                <StackPanel x:Name="VoiceAsrArea">
