                        <Border Style="{StaticResource Card}" Tag="card">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="识别模块" />
                                <StackPanel x:Name="AsrModuleList" />
                                <Button Content="＋ 添加识别模块" Style="{StaticResource LinkButton}" Click="OnAddAsrModule" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Tag="card">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="module.json 约定" />
                                <TextBlock Style="{StaticResource RowHint}"
                                           Text="modules/&lt;名称&gt;/module.json · kind=llm/tts/asr" ToolTip="entry 为模块目录内的可执行文件名；缺字段时按目录名前缀推断，requires 视为 none" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== 关于 ==================== -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="关于" />

                        <Border Style="{StaticResource Card}" Tag="card">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="本程序" />
                                <Grid Margin="0,6" Tag="row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="版本号" />
                                    <TextBlock x:Name="VersionText" Grid.Column="1" Style="{StaticResource ValueText}" Text="—" />
                                </Grid>
                                <Grid Margin="0,6" Tag="row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="仓库地址" />
                                    <TextBlock x:Name="RepoText" Grid.Column="1" Style="{StaticResource AccentText}" Text="—" />
                                </Grid>
                                <Grid Margin="0,6" Tag="row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="数据文件" />
                                    <TextBlock x:Name="StorePathText" Grid.Column="1" Style="{StaticResource ValueText}" MaxWidth="520" Text="—" />
                                </Grid>
                                <Grid Margin="0,6" Tag="row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="模块目录" />
                                    <TextBlock x:Name="ModulesPathText" Grid.Column="1" Style="{StaticResource ValueText}" MaxWidth="520" Text="—" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Tag="card">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="config.yaml 说明" />
                                <TextBlock Style="{StaticResource RowHint}"
                                           Text="只读 · 界面改动写入 Assets\appearance.json" ToolTip="config.yaml 是用户的配置文件，程序只读、绝不回写；界面改动写入 Assets\appearance.json 覆盖层，删除该文件即恢复出厂默认" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ==================== 底部：恢复默认 + 自动保存状态 ==================== -->
        <Grid Grid.Row="2" Margin="2,8,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource LinkButton}"
                    Content="恢复默认"
                    Click="OnRestoreDefaults" />

            <TextBlock Grid.Column="2"
                       x:Name="AutoSaveText"
                       Style="{StaticResource ValueText}"
                       Text="自动保存" />
        </Grid>
    </Grid>
</Window>
